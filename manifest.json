{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "author": "TeamMaid",
  "homepage_url": "https://team-maid.de/",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "eisenhower@team-maid.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "storage"
  ],
  "background": {
    "scripts": [
      "quadrants.js",
      "background.js"
    ]
  },
  "icons": {
    "32": "icons/eisenhower-32.png",
    "64": "icons/eisenhower-64.png",
    "128": "icons/eisenhower-128.png"
  }
}
